  "test_publish_batch": {
    "delivered": [
      "one",
      "two"
    ],
    "eleven": {
      "Error": {
        "Code": "TooManyEntriesInBatchRequest",
        "Message": "The batch request contains more entries than permissible."
      },
      "ResponseMetadata": {
        "HTTPStatusCode": 400
      }
    },
    "empty": {
      "Error": {
        "Code": "EmptyBatchRequest",
        "Message": "The batch request doesn't contain any entries."
      },
      "ResponseMetadata": {
        "HTTPStatusCode": 400
      }
    },
    "publish": {
      "Failed": [],
      "ResponseMetadata": {
        "HTTPStatusCode": 200
      },
      "Successful": [
        {
          "Id": "a",
          "MessageId": "<uuid:1>"
        },
        {
          "Id": "b",
          "MessageId": "<uuid:2>"
        }
      ]
    },
    "repeated-ids": {
