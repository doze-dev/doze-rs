{
  "name": "@doze/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The components the doze consoles share: behaviour and layout, never a colour.",
  "sideEffects": ["**/*.css", "./src/lib/opener.ts", "./src/lib/leaving.ts"],
  "exports": {
    ".": "./src/index.ts",
    "./components/ui/*": "./src/components/ui/*.tsx",
    "./components/app/copy": "./src/components/app/copy.ts",
    "./components/app/*": "./src/components/app/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./styles/base.css": "./src/styles/base.css",
    "./themes/*.css": "./themes/*.css",
    "./package.json": "./package.json"
  },
  "files": ["src", "themes", "README.md"],
  "scripts": {
    "build": "bun run typecheck",
    "typecheck": "bunx --bun tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "@tanstack/react-router": "1.170.46",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.6",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.26",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.72.0",
    "radix-ui": "1.8.1",
    "react-hook-form": "7.92.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tanstack/react-router": "1.170.46",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
