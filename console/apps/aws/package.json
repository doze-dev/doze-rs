{
  "name": "doze-aws-console",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The doze-aws web console: built into crates/aws-console/web-dist and embedded in the doze-aws binary.",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bun run typecheck && bun scripts/embed.ts",
    "typecheck": "bunx --bun tsc -b --noEmit",
    "test": "bun test src scripts",
    "e2e": "bunx --bun playwright test -c e2e/playwright.config.ts",
    "shots": "bun --bun e2e/shots.ts",
    "install-browsers": "bunx --bun playwright install firefox webkit chromium"
  },
  "dependencies": {
    "@doze/ui": "workspace:*",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "8.21.3",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "vite": "8.3.8"
  }
}
