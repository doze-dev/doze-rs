{
  "actions": [
    {
      "fields": [
        {
          "help": "What the message says; JSON reads as JSON in the viewer.",
          "id": "value",
          "kind": "text",
          "label": "Value"
        },
        {
          "help": "Messages with the same key go to the same partition.",
          "id": "key",
          "kind": "text",
          "label": "Key"
        },
        {
          "help": "One name=value a line.",
          "id": "headers",
          "kind": "pairs",
          "label": "Headers"
        },
        {
          "help": "Leave blank to let the key choose, as a Java client would (partition 0 without a key).",
          "id": "partition",
          "kind": "number",
          "label": "Partition",
          "max": 999,
          "min": 0
        }
      ],
      "id": "produce",
      "input_hint": "message value",
      "kind": "topic",
      "label": "Produce a message"
    },
    {
      "fields": [
        {
          "help": "Letters, digits, '.', '_' and '-', up to 249 of them.",
          "id": "name",
          "kind": "text",
          "label": "Name",
          "required": true
        },
        {
          "default": "1",
          "id": "partitions",
          "kind": "number",
          "label": "Partitions",
          "max": 1000,
          "min": 1,
          "required": true
        },
        {
          "default": "1",
          "help": "This broker is a single node.",
          "id": "replication",
          "kind": "number",
          "label": "Replication",
          "max": 1,
          "min": 1,
          "required": true
        },
        {
          "choices": [
            "delete",
            "compact"
          ],
          "default": "delete",
          "help": "Delete old messages, or keep the newest of each key.",
          "id": "cleanup",
          "kind": "choice",
          "label": "Clean-up",
          "required": true
        },
        {
          "help": "How long a message is kept. Blank keeps the broker's default; 0 keeps messages for ever.",
          "id": "retention_hours",
          "kind": "number",
          "label": "Retention (hours)",
          "max": 87600,
          "min": 0
        }
      ],
      "id": "create-topic",
      "input_hint": "topic name",
      "kind": "",
      "label": "Create a topic"
    }
  ],
  "spec": {
