# Larder — groceries at your door within d an order's life. Reserves stock with catalog,
# publishes orders.placed and follows payments.*.
app "orders" {
  run   = "go run ./services/orders"
  watch = ["services/orders/**/*.go", "platform/**/*.go"]
  port  = 8003
  ready = http("/healthz")
  after = [task.migrate-orders]
  sleep = "never" # it consumes Kafka: no request would ever wake it

  env = {
    DATABASE_URL  = "postgres://orders:orders@${modul = "never"

  env = {
    DATABASE_URL  = "postgres://payments:payments@${module..kafka.address
    AWS_ENDPOINT_URL = module.aws.url
    PICK_LISTS_QUEUE = "pick-lists"
    RECEIPTS_BUCKET  = "receipts"
    ORDERS_URL       =pit --smtp $HOST:$PORT --listen 127.0.0.1:8025 --database $DATA/mail    = { DATABASE_URL = "postgres://catalog:catalog@${module.postgres.address}/postgres?sslmode=disable" }
}

